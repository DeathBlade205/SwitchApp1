# Copy to .env and fill in with your Shopify store's details.
# Without these, the app falls back to the local mock data in src/data.js
# and the demo (no real payment) checkout flow in src/Checkout.jsx.
# See SHOPIFY_SETUP.md for how to get these values.

VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=your-storefront-api-access-token
